# ==============================================================================
# NEXORA CRM - UNIVERSAL ENTERPRISE SAAS PLATFORM CONFIGURATION
# ==============================================================================

# Database Connection (SQLite by default for zero-config, PostgreSQL in production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for AWS RDS / Supabase / Neon:
# DATABASE_URL="postgresql://nexora_user:password@localhost:5432/nexora_crm?schema=public"

# Authentication & Session Security
JWT_SECRET="nexora-enterprise-super-secure-jwt-secret-key-2026-production"
AUTH_COOKIE_NAME="nexora_auth_token"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional External Integrations (Fallback to demo mode when empty)
# Mailgun / Sendgrid SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Stripe Payment Gateway
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Slack Notifications Webhook
SLACK_WEBHOOK_URL=""

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# NEXORA AI Assistant (Gemini / OpenAI / Anthropic API Key)
# When omitted, NEXORA AI operates in deterministic enterprise intelligence mode
GEMINI_API_KEY=""
OPENAI_API_KEY=""
